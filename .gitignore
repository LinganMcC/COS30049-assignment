# Raw downloaded datasets
data/raw/*
!data/raw/.gitkeep
!data/raw/README.md

# Preprocessed/generated datasets
data/processed/*
!data/processed/.gitkeep
!data/processed/README.md

# Sentence-split datasets
data/sentences/*
!data/sentences/.gitkeep
!data/sentences/README.md

# Generated feature tables
data/features/*
data/features/.csv
!data/features/.gitkeep
!data/features/README.md

# Feature extraction checkpoints
data/features/.checkpoints/


# ============================================================
# LOGISTIC REGRESSION OUTPUTS
# ============================================================

# All generated Logistic Regression results stay local
logistic_regression/outputs/


# ============================================================
# EXPERIMENT OUTPUTS
# ============================================================

# Generated feature-analysis CSV files
results/feature_analysis/**/*.csv

# Generated exploratory figures
results/feature_analysis/train/**/*.png
results/feature_analysis/train/**/*.jpg
results/feature_analysis/train/**/*.jpeg
results/feature_analysis/train/**/*.svg

# Keep report-ready material if you intentionally place it here
!results/report/
!results/report/**


