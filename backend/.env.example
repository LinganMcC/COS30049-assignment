# Copy to backend/.env and adjust. Every value has a safe default in app/config.py.

# The one origin allowed by CORS - the Vite dev server by default.
FRONTEND_ORIGIN=http://localhost:5173

# Input limits (Req 12: up to 1,000 words). MAX_BODY_BYTES is checked before
# the JSON is parsed, so it sits a little above MAX_CHARS to allow for JSON
# escaping and multi-byte characters.
MAX_WORDS=1000
MAX_CHARS=8000
MAX_BODY_BYTES=32768

# Denial-of-service defence. Set DOS_PROTECTION=false only to demonstrate the
# attack succeeding without it.
DOS_PROTECTION=true
INFERENCE_WORKERS=2
INFERENCE_QUEUE=4
INFERENCE_TIMEOUT_SECONDS=10
TORCH_THREADS=2

# Detection-evasion defence (Unicode normalisation before the model).
NORMALISE_INPUT=true

# Misconfiguration defence.
SECURITY_HEADERS=true
ENABLE_DOCS=true
