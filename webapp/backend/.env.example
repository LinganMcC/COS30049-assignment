# Copy this file to .env (it is git-ignored) and adjust if needed.

# The ONE origin allowed to call the API from a browser (exact match).
FRONTEND_ORIGIN=http://localhost:5173

# Input limits (see README section 4 for why)
MAX_WORDS=1000
MIN_WORDS=20
MAX_CHARS=20000
MAX_BODY_BYTES=131072

# Defence A (2.7 Advanced): denial of service. Set to false only for the
# before/after demonstration, then set it back to true.
DOS_GUARD_ENABLED=true
MAX_CONCURRENT_ANALYSES=4

# Section 2.8: detection evasion (Unicode normalisation)
EVASION_DEFENCE_ENABLED=true

# Defence B (2.7 Intermediate, misconfiguration): turn off /docs in production.
SHOW_DOCS=true
